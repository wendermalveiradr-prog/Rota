package com.example.domain

import android.content.Context
import android.location.Geocoder
import android.os.Build
import com.squareup.moshi.JsonClass
import com.squareup.moshi.Moshi
import com.squareup.moshi.kotlin.reflect.KotlinJsonAdapterFactory
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.suspendCancellableCoroutine
import kotlinx.coroutines.withContext
import okhttp3.OkHttpClient
import retrofit2.Retrofit
import retrofit2.converter.moshi.MoshiConverterFactory
import retrofit2.http.GET
import retrofit2.http.Path
import retrofit2.http.Query
import java.util.Locale
import java.util.concurrent.TimeUnit
import kotlin.coroutines.resume
import kotlin.math.atan2
import kotlin.math.cos
import kotlin.math.pow
import kotlin.math.sin
import kotlin.math.sqrt

@JsonClass(generateAdapter = true)
data class OsrmRouteResponse(
    val code: String,
    val routes: List<OsrmRoute> = emptyList()
)

@JsonClass(generateAdapter = true)
data class OsrmRoute(
    val distance: Double = 0.0,
    val duration: Double = 0.0,
    val legs: List<OsrmLeg> = emptyList()
)

@JsonClass(generateAdapter = true)
data class OsrmLeg(
    val distance: Double = 0.0,
    val duration: Double = 0.0
)

interface OsrmRoutingApi {
    @GET("route/v1/driving/{coordinates}")
    suspend fun getDrivingRoute(
        @Path("coordinates", encoded = true) coordinates: String,
        @Query("overview") overview: String = "false"
    ): OsrmRouteResponse
}

data class RouteCalculationResult(
    val leg1CurrentToPickupKm: Double,
    val leg2PickupToCustomerKm: Double,
    val leg3CustomerToCenterKm: Double,
    val totalKm: Double,
    val routeSource: String
)

class RouteCalculator(private val context: Context) {

    private val moshi: Moshi = Moshi.Builder()
        .addLast(KotlinJsonAdapterFactory())
        .build()

    private val okHttpClient: OkHttpClient = OkHttpClient.Builder()
        .connectTimeout(3500, TimeUnit.MILLISECONDS)
        .readTimeout(3500, TimeUnit.MILLISECONDS)
        .build()

    private val osrmApi: OsrmRoutingApi = Retrofit.Builder()
        .baseUrl("https://router.project-osrm.org/")
        .client(okHttpClient)
        .addConverterFactory(MoshiConverterFactory.create(moshi))
        .build()
        .create(OsrmRoutingApi::class.java)

    suspend fun calculateCompleteRoute(
        currentLocation: GeoPoint,
        pickupAddress: String,
        customerAddress: String,
        useOsrmRoadRouting: Boolean
    ): RouteCalculationResult = withContext(Dispatchers.IO) {
        val pickupPoint = resolveAddressPoint(pickupAddress)
            ?: GeoPoint(
                MontesClarosGeoCatalog.DOWNTOWN_MONTES_CLAROS.latitude + 0.006,
                MontesClarosGeoCatalog.DOWNTOWN_MONTES_CLAROS.longitude - 0.005,
                pickupAddress
            )

        val customerPoint = resolveAddressPoint(customerAddress)
            ?: GeoPoint(
                MontesClarosGeoCatalog.DOWNTOWN_MONTES_CLAROS.latitude - 0.012,
                MontesClarosGeoCatalog.DOWNTOWN_MONTES_CLAROS.longitude + 0.011,
                customerAddress
            )

        val centerPoint = MontesClarosGeoCatalog.DOWNTOWN_MONTES_CLAROS

        if (useOsrmRoadRouting) {
            try {
                val coordPath = listOf(currentLocation, pickupPoint, customerPoint, centerPoint)
                    .joinToString(";") { "${it.longitude},${it.latitude}" }
                val response = osrmApi.getDrivingRoute(coordPath)
                val legs = response.routes.firstOrNull()?.legs
                if (response.code.equals("Ok", ignoreCase = true) && legs != null && legs.size >= 3) {
                    val l1 = (legs[0].distance / 1000.0).coerceAtLeast(0.2)
                    val l2 = (legs[1].distance / 1000.0).coerceAtLeast(0.2)
                    val l3 = (legs[2].distance / 1000.0).coerceAtLeast(0.2)
                    return@withContext RouteCalculationResult(
                        leg1CurrentToPickupKm = round2(l1),
                        leg2PickupToCustomerKm = round2(l2),
                        leg3CustomerToCenterKm = round2(l3),
                        totalKm = round2(l1 + l2 + l3),
                        routeSource = "OSRM_REAL_ROADS"
                    )
                }
            } catch (_: Exception) {
                // Fall back seamlessly to urban street-factor Haversine
            }
        }

        // Urban street grid winding factor for Montes Claros (1.32x)
        val urbanFactor = 1.32
        val l1 = (haversineKm(currentLocation, pickupPoint) * urbanFactor).coerceAtLeast(0.25)
        val l2 = (haversineKm(pickupPoint, customerPoint) * urbanFactor).coerceAtLeast(0.35)
        val l3 = (haversineKm(customerPoint, centerPoint) * urbanFactor).coerceAtLeast(0.25)
        RouteCalculationResult(
            leg1CurrentToPickupKm = round2(l1),
            leg2PickupToCustomerKm = round2(l2),
            leg3CustomerToCenterKm = round2(l3),
            totalKm = round2(l1 + l2 + l3),
            routeSource = "ESTIMATED_URBAN"
        )
    }

    private suspend fun resolveAddressPoint(rawAddress: String): GeoPoint? {
        // 1. Try local Montes Claros neighborhood & landmark catalog first (fast + deterministic)
        MontesClarosGeoCatalog.resolveCoordinatesFromCatalog(rawAddress)?.let { catalogPoint ->
            // Add tiny deterministic street-level offset if Geocoder fails, or refine via Geocoder
            val geocoded = geocodeInMontesClaros(rawAddress)
            return geocoded ?: catalogPoint
        }
        // 2. Try Android Geocoder scoped to Montes Claros, MG
        return geocodeInMontesClaros(rawAddress)
    }

    private suspend fun geocodeInMontesClaros(rawAddress: String): GeoPoint? {
        if (!Geocoder.isPresent()) return null
        val query = if (rawAddress.contains("montes claros", ignoreCase = true)) {
            rawAddress
        } else {
            "$rawAddress, Montes Claros, MG, Brazil"
        }
        return try {
            val geocoder = Geocoder(context, Locale("pt", "BR"))
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
                suspendCancellableCoroutine { cont ->
                    geocoder.getFromLocationName(
                        query,
                        1,
                        -16.86,
                        -44.00,
                        -16.60,
                        -43.75
                    ) { addresses ->
                        val addr = addresses.firstOrNull()
                        if (cont.isActive) {
                            cont.resume(addr?.let { GeoPoint(it.latitude, it.longitude, rawAddress) })
                        }
                    }
                }
            } else {
                @Suppress("DEPRECATION")
                val list = geocoder.getFromLocationName(query, 1, -16.86, -44.00, -16.60, -43.75)
                list?.firstOrNull()?.let { GeoPoint(it.latitude, it.longitude, rawAddress) }
            }
        } catch (_: Exception) {
            null
        }
    }

    private fun haversineKm(a: GeoPoint, b: GeoPoint): Double {
        val earthRadiusKm = 6371.0
        val dLat = Math.toRadians(b.latitude - a.latitude)
        val dLon = Math.toRadians(b.longitude - a.longitude)
        val lat1 = Math.toRadians(a.latitude)
        val lat2 = Math.toRadians(b.latitude)
        val h = sin(dLat / 2).pow(2) + cos(lat1) * cos(lat2) * sin(dLon / 2).pow(2)
        return 2 * earthRadiusKm * atan2(sqrt(h), sqrt(1 - h))
    }

    private fun round2(value: Double): Double = Math.round(value * 100.0) / 100.0
}
