    private val landmarkHints: Map<String, String> = mapOf(
        "montes claros shopping" to "Augusta Mota",
        "ibituruna center" to "Ibituruna",
        "praca dr carlos" to "Centro",
        "praca doutor carlos" to "Centro",
        "mercado municipal" to "Centro",
        "esteves rodrigues" to "Centro",
        "sanitária" to "Centro",
        "mestra fininha" to "Jardim São Luiz",
        "dulce sarmento" to "Melo",
        "correa machado" to "Ibituruna",
        "joao xxiii" to "Santos Reis",
        "plínio ribeiro" to "Jardim Brasil"
    )

    fun defaultRuleEntities(): List<NeighborhoodRuleEntity> = knownNeighborhoods.map { item ->
        NeighborhoodRuleEntity(
            name = item.name,
            normalizedKey = normalize(item.name),
            status = item.defaultStatus.name,
            notes = item.defaultNote,
            isCustom = false
        )
    }

    fun normalize(text: String): String {
        val decomposed = Normalizer.normalize(text.lowercase().trim(), Normalizer.Form.NFD)
        return decomposed.replace(Regex("\\p{InCombiningDiacriticalMarks}+"), "")
            .replace(Regex("[^a-z0-9\\s]"), " ")
            .replace(Regex("\\s+"), " ")
            .trim()
    }

    fun detectNeighborhoodRule(
        address: String,
        rules: List<NeighborhoodRuleEntity>
    ): NeighborhoodRuleEntity? {
        val normalizedAddress = normalize(address)
        if (normalizedAddress.isBlank()) return null

        val sortedRules = rules.sortedByDescending { it.normalizedKey.length }
        sortedRules.firstOrNull { rule ->
            rule.normalizedKey.isNotBlank() && normalizedAddress.contains(rule.normalizedKey)
        }?.let { return it }

        landmarkHints.entries.firstOrNull { (hint, _) ->
            normalizedAddress.contains(normalize(hint))
        }?.let { (_, neighborhoodName) ->
            return rules.firstOrNull { normalize(it.name) == normalize(neighborhoodName) }
        }

        return null
    }

    fun extractNeighborhoodLabel(
        address: String,
        rules: List<NeighborhoodRuleEntity>
    ): String {
        detectNeighborhoodRule(address, rules)?.let { return it.name }

        val bairroRegex = Regex("(?i)bairro\\s+([\\p{L}0-9\\s]{3,30})")
        bairroRegex.find(address)?.groupValues?.getOrNull(1)?.trim()?.let {
            if (it.isNotBlank()) return it
        }

        val parts = address.split("-", ",").map { it.trim() }.filter { it.isNotBlank() }
        if (parts.size >= 2) {
            val candidate = parts.last()
            if (!candidate.equals("Montes Claros", ignoreCase = true) &&
                !candidate.equals("MG", ignoreCase = true) &&
                candidate.length in 3..32
            ) {
                return candidate
            }
        }
        return "Bairro não identificado"
    }

    fun resolveCoordinatesFromCatalog(address: String): GeoPoint? {
        val normalized = normalize(address)
        if (normalized.isBlank()) return null

        val match = knownNeighborhoods
            .sortedByDescending { normalize(it.name).length }
            .firstOrNull { normalized.contains(normalize(it.name)) }
        if (match != null) {
            return GeoPoint(match.latitude, match.longitude, match.name)
        }

        val landmark = landmarkHints.entries.firstOrNull { (hint, _) ->
            normalized.contains(normalize(hint))
        }?.value
        if (landmark != null) {
            knownNeighborhoods.firstOrNull { it.name == landmark }?.let {
                return GeoPoint(it.latitude, it.longitude, it.name)
            }
        }
        return null
    }
}
